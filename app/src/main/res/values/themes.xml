<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AniDeskTv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.AniDeskTv.Splash" parent="Theme.AniDeskTv" />

    <style name="Theme.AniDesk.Player" parent="Theme.Leanback">
        <item name="android:colorPrimary">@color/player_accent</item>
        <item name="android:colorPrimaryDark">@color/player_accent</item>
        <item name="android:colorAccent">@color/player_accent</item>
        <item name="android:colorBackground">@color/player_background</item>
        <item name="android:windowBackground">@color/player_background</item>
        <item name="playbackControlsAutoHideTimeout">5000</item>
        <item name="playbackControlsAutoHideTickleTimeout">5000</item>
    </style>

    <style name="AppTheme.Player.LeanbackWizard" parent="Theme.Leanback.GuidedStep">
        <item name="guidedStepBackground">@color/player_guided_background</item>
        <item name="guidedActionsBackground">@color/player_guided_background</item>
        <item name="guidedActionsElevation">0dp</item>
    </style>

    <style name="AppTheme.Player.ResumeDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorPrimary">@color/player_accent</item>
        <item name="android:colorAccent">@color/player_accent</item>
        <item name="android:windowBackground">@color/player_background</item>
        <item name="android:windowMinWidthMajor">420dp</item>
        <item name="android:windowMinWidthMinor">420dp</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
        <item name="android:buttonBarStyle">@style/AppTheme.Player.DialogButtonBar</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppTheme.Player.DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AppTheme.Player.DialogButton</item>
    </style>

    <style name="AppTheme.Player.DialogButtonBar" parent="@android:style/Widget.Material.ButtonBar">
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="AppTheme.Player.DialogButton" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/player_dialog_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
</resources>